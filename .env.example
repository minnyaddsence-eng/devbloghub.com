# Optional: Twitter/X handle for metadata (with or without @)
# NEXT_PUBLIC_TWITTER_SITE=@yourhandle

# Optional: override GA4 ID (default in code is G-4F7B72XCJ4)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Monetag OnClick (popunder): default zone is set in components/MonetagScript.tsx
# NEXT_PUBLIC_MONETAG_ONCLICK_ZONE=10858167
# Local/dev: skip loading OnClick
# NEXT_PUBLIC_MONETAG_ONCLICK_DISABLED=true
